# Copiar este archivo como .env y poner la IP de la compu donde corre la API.
# Windows: ipconfig (Dirección IPv4). Mac: ipconfig getifaddr en0.
# No va "localhost": el teléfono no lo resuelve.
# Después de cambiarla, reiniciar Metro con "npx expo start -c".

EXPO_PUBLIC_API_URL="http://192.168.0.10:3000"
